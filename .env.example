# Python exporter
FANQIE_APP_API=http://127.0.0.1:9999
FANQIE_PUBLIC_USER_AGENT=Mozilla/5.0 (compatible; FanqieExportPipeline/1.0)

# Java reader/signing service (fill locally; never commit the real values)
FANQIE_API_ENABLED=false
FANQIE_API_BASE_URL=https://<upstream-api-host>
FANQIE_USER_AGENT=<client-user-agent>
FANQIE_COOKIE=<session-cookie>
FANQIE_REGISTRATION_KEY=<32-hex-character-deployment-key>
FANQIE_CDID=<uuid>
FANQIE_DEVICE_ID=<numeric-device-id>
FANQIE_INSTALL_ID=<numeric-install-id>
FANQIE_DEVICE_BRAND=<brand>
FANQIE_DEVICE_TYPE=<model>
FANQIE_DPI=640
FANQIE_HOST_ABI=arm64-v8a
FANQIE_RESOLUTION=3200*1440
FANQIE_ROM_VERSION=<rom-version>
